{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "allowJs": true,
    "checkJs": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    // TS 7 no longer auto-includes every node_modules/@types package —
    // global types must be listed. web-bluetooth: the Bluetooth types
    // cubecore's smart-cube sessions use; bun: bun:test in *.test.ts.
    "types": ["web-bluetooth", "bun"]
  },
  "include": ["src"]
}
